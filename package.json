{
  "name": "@mahavirtech/tick",
  "version": "1.0.0",
  "description": "Minimal Developer Task CLI",
  "type": "module",
  "main": "dist/cli.js",
  "bin": {
    "tick": "dist/cli.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/cli.ts",
    "start": "node dist/cli.js",
    "test": "tsx --test tests/**/*.test.ts",
    "prepublishOnly": "npm run build"
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "cli",
    "todo",
    "tasks",
    "developer",
    "minimal",
    "tick"
  ],
  "author": "Mahavirtech",
  "license": "MIT",
  "dependencies": {
    "chalk": "^6.0.0",
    "commander": "^15.0.0",
    "inquirer": "^14.2.2"
  },
  "devDependencies": {
    "@types/inquirer": "^9.0.10",
    "@types/node": "^26.6.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
